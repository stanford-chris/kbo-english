# Runtime dedup + name-cache state (rebuildable)
kbo_history.json
kbo_state.json
kbo_results_history.json
kbo_roster.json

# Backups
*.bak

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store

# Preview cards (regenerate with kbo_card_preview.py)
card_*.png

# Club logos: third-party marks, fetched and cached at runtime
logos/

# Leftover from an interrupted atomic JSON write (write_json_atomic). The temp
# name carries the writer's PID, so the pattern has to allow one in the middle.
*.json.tmp
*.json.*.tmp

# Run lock (kbo_lock) — one KBO job at a time
.kbo_run.lock
